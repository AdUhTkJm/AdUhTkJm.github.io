---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { tplStr } from "@/i18n/format";
import type { NoteSeries } from "@/lib/notes";

/**
 * The series index shown at the top of every part.
 *
 * Deliberately separate from the article's own table of contents: this one is
 * about the series (which part am I reading, what else is there), that one is
 * about this page's headings. It also sits outside `data-pagefind-body`, so a
 * search hit never matches a sibling part's title.
 *
 * `parts` comes from `blog.toml` via notes.json; nothing here is derived from
 * the page, which is what keeps the index identical across parts.
 */
type Props = { series: NoteSeries };

const { series } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const total = series.parts.length;
---

<nav
  aria-label={tplStr(t.post.seriesLabel, { title: series.title })}
  class="border-border bg-muted/40 my-8 rounded-md border px-4 py-3 text-sm"
>
  <p class="font-medium">
    {series.title}
    <span class="text-muted-foreground font-normal">
      · {tplStr(t.post.seriesPart, { index: series.index, total })}
    </span>
  </p>
  <ol class="mt-3 space-y-1">
    {
      series.parts.map((part, i) => (
        <li class="flex gap-2">
          <span class="text-muted-foreground w-4 shrink-0 text-right font-mono tabular-nums">
            {i + 1}
          </span>
          {i + 1 === series.index ? (
            <span class="text-accent font-medium" aria-current="page">
              {part.title}
            </span>
          ) : (
            <a
              href={getRelativeLocaleUrl(locale, `posts/${part.slug}`)}
              class="hover:text-accent"
            >
              {part.title}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
