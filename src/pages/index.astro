---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getAllArticles, groupArticlesByProject } from "@/lib/articles";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const postsUrl = getRelativeLocaleUrl(locale, "posts");
const homePath = getRelativeLocaleUrl(locale, "");
const articles = await getAllArticles(locale);
const groups = groupArticlesByProject(articles);
---

<Layout>
  <Fragment slot="head">
    <meta name="bo-ke-verify" content="4375641dde684a456255d0d980a7277a" />
  </Fragment>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        AdUhTkJm
      </h1>

      <p>主要是一些技术记录，还有语言，小说，游戏之类的。</p>

      <p>
        我用最直白，最不绕弯子的话告诉你，这个博客不是由
        AI，而是完全由我这个人类编写。当然，你要是觉得我未通过图灵测试，那也没有办法（
      </p>

      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      articles.length > 0 && (
        <section id="articles" class="pt-12 pb-6">
          <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="text-2xl font-semibold tracking-wide">
              {t.home.articles}
            </h2>
            <LinkButton
              class="hover:text-accent text-muted-foreground text-sm underline decoration-dashed underline-offset-4"
              href={postsUrl}
            >
              {t.home.allPosts} ({articles.length}) →
            </LinkButton>
          </div>

          {groups.map(({ project, articles: groupArticles }) => (
            <section id={project.id} class="mb-10 scroll-mt-20">
              <div class="mb-4">
                <h3 class="text-xl font-bold">{project.title}</h3>
                {project.description && (
                  <p class="text-muted-foreground mt-1 text-sm">
                    {project.description}
                  </p>
                )}
              </div>
              <ul class="space-y-3">
                {groupArticles.map(article => (
                  <ArticleCard
                    article={article}
                    variant="h4"
                    showProject={false}
                  />
                ))}
              </ul>
            </section>
          ))}
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={postsUrl}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
