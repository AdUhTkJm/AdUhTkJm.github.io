---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";
import {
  notes,
  noteBody,
  projectOf,
  sourceLabel,
  typstVersion,
} from "@/lib/notes";
import "@/styles/note.css";

export function getStaticPaths() {
  return notes.map(note => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const project = projectOf(note);
const body = noteBody(note.slug);
const toc = note.toc.filter(entry => entry.level <= 3);

const siblings = notes.filter(n => n.project === note.project);
const index = siblings.findIndex(n => n.slug === note.slug);
const prev = index > 0 ? siblings[index - 1] : undefined;
const next =
  index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;

const dateLabel = note.date
  ? new Intl.DateTimeFormat(locale, { dateStyle: "long" }).format(
      new Date(`${note.date}T00:00:00Z`)
    )
  : null;
---

<Layout title={note.title} description={note.summary}>
  <Header />
  <main id="main-content" class="app-layout my-8">
    <nav
      class="text-muted-foreground mb-6 flex flex-wrap items-center gap-2 text-sm"
    >
      <a href={getRelativeLocaleUrl(locale, "notes")} class="hover:text-accent">
        笔记
      </a>
      <span aria-hidden="true">/</span>
      <a
        href={`${getRelativeLocaleUrl(locale, "notes")}#${project.id}`}
        class="hover:text-accent">{project.title}</a
      >
    </nav>

    <header class="border-border mb-8 border-b pb-6">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        {note.title}
      </h1>
      {
        note.summary && (
          <p class="text-muted-foreground mt-3 leading-relaxed">
            {note.summary}
          </p>
        )
      }
      <div
        class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs"
      >
        {dateLabel && <span>{dateLabel}</span>}
        <span title={note.source.declared}>{sourceLabel(note)}</span>
        {note.math > 0 && <span>{note.math} 个公式</span>}
        {
          note.pdf && (
            <a
              href={getAssetPath(note.pdf)}
              class="hover:text-accent underline underline-offset-2"
            >
              PDF
            </a>
          )
        }
        {
          note.tags.map(tag => (
            <span class="rounded-sm border border-current px-1.5 py-0.5">
              {tag}
            </span>
          ))
        }
      </div>
    </header>

    {
      toc.length > 4 && (
        <details
          class="border-border bg-muted/40 mb-8 rounded-md border px-4 py-3"
          open
        >
          <summary class="cursor-pointer text-sm font-medium">目录</summary>
          <ol class="mt-3 space-y-1 text-sm">
            {toc.map(entry => (
              <li style={`padding-left: ${(entry.level - 2) * 1}rem`}>
                <a href={`#${entry.id}`} class="hover:text-accent">
                  {entry.text}
                </a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <article class="note-body" data-pagefind-body>
      <Fragment set:html={body} />
    </article>

    <footer class="border-border mt-14 border-t pt-6">
      <nav class="flex flex-col gap-2 text-sm sm:flex-row sm:justify-between">
        {
          prev ? (
            <a
              href={getRelativeLocaleUrl(locale, `notes/${prev.slug}`)}
              class="hover:text-accent"
            >
              ← {prev.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a
              href={getRelativeLocaleUrl(locale, `notes/${next.slug}`)}
              class="hover:text-accent"
            >
              {next.title} →
            </a>
          )
        }
      </nav>
    </footer>
  </main>
  <Footer />
</Layout>
