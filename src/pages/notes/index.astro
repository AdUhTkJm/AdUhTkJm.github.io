---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { groupedNotes, notes, typstVersion } from "@/lib/notes";

const locale = Astro.currentLocale ?? config.site.lang;
const groups = groupedNotes();

const formatDate = (date: string | null) =>
  date
    ? new Intl.DateTimeFormat(locale, { dateStyle: "medium" }).format(
        new Date(`${date}T00:00:00Z`)
      )
    : "";
---

<Layout
  title={`笔记 · ${config.site.title}`}
  description="按项目分组的笔记：算法、逆向、形式化与实现细节。"
>
  <Header />
  <main id="main-content" class="app-layout my-8">
    <section id="hero" class="border-border mb-10 border-b pb-6">
      <h1 class="my-2 text-4xl font-bold tracking-tight sm:text-5xl">笔记</h1>
      <p class="text-muted-foreground mt-2 font-mono text-xs">
        共 {notes.length} 篇
      </p>
    </section>

    {
      groups.map(({ project, notes: projectNotes }) => (
        <section id={project.id} class="mb-12 scroll-mt-20">
          <div class="mb-4">
            <h2 class="text-2xl font-bold">{project.title}</h2>
            {project.description && (
              <p class="text-muted-foreground mt-1 text-sm">
                {project.description}
              </p>
            )}
          </div>
          <ul class="space-y-3">
            {projectNotes.map(note => (
              <li class="border-border hover:border-accent/60 group rounded-md border p-4 transition-colors">
                <a
                  href={getRelativeLocaleUrl(locale, `notes/${note.slug}`)}
                  class="block"
                >
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <span class="group-hover:text-accent font-medium">
                      {note.title}
                    </span>
                    <span class="text-muted-foreground font-mono text-xs">
                      {formatDate(note.date)}
                    </span>
                  </div>
                  {note.summary && (
                    <p class="text-muted-foreground mt-1 text-sm leading-relaxed">
                      {note.summary}
                    </p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
  <Footer />
</Layout>
